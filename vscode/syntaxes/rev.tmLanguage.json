{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "rev",
  "scopeName": "source.rev",
  "patterns": [
    { "include": "#comment" },
    { "include": "#declaration" },
    { "include": "#call" },
    { "include": "#keyword" },
    { "include": "#number" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.rev"
    },
    "declaration": {
      "patterns": [
        { "match": "\\b(var|out)\\b", "name": "storage.type.rev" },
        { "match": "\\b(proc)\\s+([A-Za-z_]\\w*)", "captures": { "1": { "name": "storage.type.function.rev" }, "2": { "name": "entity.name.function.rev" } } },
        { "match": "\\b(main)\\b", "name": "storage.type.function.rev" },
        { "match": "@\\s*(mem)\\b", "captures": { "1": { "name": "storage.modifier.rev" } } }
      ]
    },
    "keyword": {
      "patterns": [
        { "match": "\\b(if|else|fi|from|do|loop|until)\\b", "name": "keyword.control.rev" },
        { "match": "\\b(call|uncall)\\b", "name": "keyword.control.flow.rev" },
        { "match": "\\b(skip)\\b", "name": "keyword.other.rev" },
        { "match": "\\b(events|latest)\\b", "name": "support.variable.input.rev" },
        { "match": "\\b(rol)\\b(?=\\s*\\()", "name": "support.function.builtin.rev" }
      ]
    },
    "number": {
      "patterns": [
        { "match": "\\b0[xX][0-9a-fA-F_]+\\b", "name": "constant.numeric.hex.rev" },
        { "match": "\\b0[bB][01_]+\\b", "name": "constant.numeric.binary.rev" },
        { "match": "\\b[0-9][0-9_]*\\b", "name": "constant.numeric.decimal.rev" }
      ]
    },
    "operator": {
      "patterns": [
        { "match": "<=>", "name": "keyword.operator.swap.rev" },
        { "match": "\\+=|-=|\\^=", "name": "keyword.operator.assignment.reversible.rev" },
        { "match": "==|!=|<=|>=|<|>", "name": "keyword.operator.comparison.rev" },
        { "match": "[+\\-^&|~]", "name": "keyword.operator.arithmetic.rev" },
        { "match": "@", "name": "keyword.operator.at.rev" }
      ]
    },
    "call": {
      "match": "\\b(call|uncall)\\s+([A-Za-z_]\\w*)",
      "captures": { "1": { "name": "keyword.control.flow.rev" }, "2": { "name": "entity.name.function.rev" } }
    }
  }
}
