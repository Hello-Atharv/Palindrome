// Hello, world, reversibly. The console is a buffer in memory (SPEC 11.9), so what has been printed depends on the time:
// step back and the text un-prints, letter by letter. A normal computer cannot un-print; here the text is just information
// the program could not erase, so the cost report counts it as garbage.
var i = 0;

main {
  print "Hello, world!\n";
  from (i == 0) loop {
    i += 1;
    print "This is line ", i, " of 3.\n";
  } until (i == 3);
  i -= 3;
  print "Now step back: the text un-prints.\n";
}
