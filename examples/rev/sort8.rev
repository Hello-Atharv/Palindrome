// Sort eight numbers reversibly with a sorting network, written in rev (generated by lang/tools/gen_sort8.py).
// The same network as examples/demos/sort.s (19 compare-exchanges) on the same eight numbers in the same order (there they are the red
// byte of eight colours, here just the numbers), so the compiler's output can be compared with the hand-written assembly: see lang/README.md.
// Each compare-exchange swaps if the pair is out of order, and files one bit in `garbage`: that bit is what the sort forgot.
// Sorted list + garbage = the original list, so the program run backwards unsorts it exactly.
// It prints the list before and after, and the 19 flags (1 = that pair was swapped): step back and the text un-prints.
var f = 0;
var a[8] = {176, 48, 112, 32, 240, 48, 192, 16};
var garbage[19];
out a;

main {
  print "before: ", a[0], " ", a[1], " ", a[2], " ", a[3], " ", a[4], " ", a[5], " ", a[6], " ", a[7], "\n";
  if (a[0] > a[2]) { a[0] <=> a[2]; f += 1; } fi (f != 0);
  garbage[0] ^= f; f ^= garbage[0];
  if (a[1] > a[3]) { a[1] <=> a[3]; f += 1; } fi (f != 0);
  garbage[1] ^= f; f ^= garbage[1];
  if (a[4] > a[6]) { a[4] <=> a[6]; f += 1; } fi (f != 0);
  garbage[2] ^= f; f ^= garbage[2];
  if (a[5] > a[7]) { a[5] <=> a[7]; f += 1; } fi (f != 0);
  garbage[3] ^= f; f ^= garbage[3];
  if (a[0] > a[4]) { a[0] <=> a[4]; f += 1; } fi (f != 0);
  garbage[4] ^= f; f ^= garbage[4];
  if (a[1] > a[5]) { a[1] <=> a[5]; f += 1; } fi (f != 0);
  garbage[5] ^= f; f ^= garbage[5];
  if (a[2] > a[6]) { a[2] <=> a[6]; f += 1; } fi (f != 0);
  garbage[6] ^= f; f ^= garbage[6];
  if (a[3] > a[7]) { a[3] <=> a[7]; f += 1; } fi (f != 0);
  garbage[7] ^= f; f ^= garbage[7];
  if (a[0] > a[1]) { a[0] <=> a[1]; f += 1; } fi (f != 0);
  garbage[8] ^= f; f ^= garbage[8];
  if (a[2] > a[3]) { a[2] <=> a[3]; f += 1; } fi (f != 0);
  garbage[9] ^= f; f ^= garbage[9];
  if (a[4] > a[5]) { a[4] <=> a[5]; f += 1; } fi (f != 0);
  garbage[10] ^= f; f ^= garbage[10];
  if (a[6] > a[7]) { a[6] <=> a[7]; f += 1; } fi (f != 0);
  garbage[11] ^= f; f ^= garbage[11];
  if (a[2] > a[4]) { a[2] <=> a[4]; f += 1; } fi (f != 0);
  garbage[12] ^= f; f ^= garbage[12];
  if (a[3] > a[5]) { a[3] <=> a[5]; f += 1; } fi (f != 0);
  garbage[13] ^= f; f ^= garbage[13];
  if (a[1] > a[4]) { a[1] <=> a[4]; f += 1; } fi (f != 0);
  garbage[14] ^= f; f ^= garbage[14];
  if (a[3] > a[6]) { a[3] <=> a[6]; f += 1; } fi (f != 0);
  garbage[15] ^= f; f ^= garbage[15];
  if (a[1] > a[2]) { a[1] <=> a[2]; f += 1; } fi (f != 0);
  garbage[16] ^= f; f ^= garbage[16];
  if (a[3] > a[4]) { a[3] <=> a[4]; f += 1; } fi (f != 0);
  garbage[17] ^= f; f ^= garbage[17];
  if (a[5] > a[6]) { a[5] <=> a[6]; f += 1; } fi (f != 0);
  garbage[18] ^= f; f ^= garbage[18];
  print "sorted: ", a[0], " ", a[1], " ", a[2], " ", a[3], " ", a[4], " ", a[5], " ", a[6], " ", a[7], "\n";
  print "flags:  ", garbage[0], garbage[1], garbage[2], garbage[3], garbage[4], garbage[5], garbage[6], garbage[7], garbage[8], garbage[9], garbage[10], garbage[11], garbage[12], garbage[13], garbage[14], garbage[15], garbage[16], garbage[17], garbage[18], "\n";
}
