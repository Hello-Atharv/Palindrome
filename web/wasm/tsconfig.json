{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "test",
    "lib/*.d.ts",
    "../../spec/vm_api.ts",
    "../../asm/src"
  ]
}
