{
  "name": "revvm-viz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Visualiser and app shell for the reversible machine (talks to the VM only through spec/vm_api.ts)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:layout": "node scripts/layout-check.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "marked": "^18.1.1"
  }
}
