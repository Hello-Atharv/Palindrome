{
  "name": "revvm",
  "version": "0.0.0",
  "private": true,
  "description": "OxHack 2026: a reversible computer",
  "scripts": {
    "build": "cmake --preset default && cmake --build --preset default",
    "test": "npm run build && ctest --preset default",
    "dev": "cmake --preset debug && cmake --build --preset debug",
    "test:asm": "npm --prefix asm test",
    "build:asm": "npm --prefix asm install && npm --prefix asm run build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:wasm": "npm --prefix web/wasm test",
    "test:twins": "npm --prefix bench/twins test",
    "bench:twins": "npm --prefix bench/twins run report",
    "test:lang": "npm --prefix lang test",
    "rvmc": "node lang/node_modules/vite-node/vite-node.mjs lang/src/cli.ts --",
    "rvm": "node cli/node_modules/vite-node/vite-node.mjs cli/src/rvm.ts --",
    "test:cli": "npm --prefix cli test"
  }
}
